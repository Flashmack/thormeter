<Application x:Class="ThorMeter.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#202837"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#32425D"/><Setter Property="Foreground" Value="#F3F6FC"/>
      <Setter Property="BorderBrush" Value="#516583"/><Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D6E1F5"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="ToolTip"><Setter Property="MaxWidth" Value="400"/></Style>
  </Application.Resources>
</Application>
